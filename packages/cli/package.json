{
  "name": "@claude-agent/cli",
  "version": "1.0.0",
  "description": "Unified CLI for Claude Agent Platform",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "bin": {
    "claude-agent": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@claude-agent/types": "workspace:*",
    "@claude-agent/errors": "workspace:*",
    "@claude-agent/logger": "workspace:*",
    "@claude-agent/config": "workspace:*",
    "@claude-agent/core": "workspace:*",
    "@claude-agent/pipeline": "workspace:*",
    "@claude-agent/plugins": "workspace:*",
    "@claude-agent/http": "workspace:*",
    "@claude-agent/orchestrator": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
