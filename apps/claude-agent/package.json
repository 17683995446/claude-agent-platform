    "@claude-agent/logger": "workspace:*",
    "@claude-agent/config": "workspace:*",
    "@claude-agent/core": "workspace:*",
    "@claude-agent/pipeline": "workspace:*",
    "@claude-agent/plugins": "workspace:*",
    "@claude-agent/http": "workspace:*",
    "@claude-agent/cli": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
