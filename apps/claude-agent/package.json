{
  "name": "@claude-agent/app",
  "version": "1.0.0",
  "description": "Claude Agent Platform main application",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "claude-agent": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
